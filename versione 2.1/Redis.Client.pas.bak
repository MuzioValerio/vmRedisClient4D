function TRedisClient.SUnion(const aKeys: array of string): TArray<string>;
begin
  ValidateKeys(aKeys);
  var lCmd := TList<string>.Create;
  try
    lCmd.Add('SUNION');
    for var K in aKeys do lCmd.Add(K);
    Result := ResponseToStringArray(ExecuteAndParse(lCmd.ToArray));
  finally
    lCmd.Free;
  end;
end;

