  var lCmd := TList<string>.Create;
  try
    lCmd.Add('SUNIONSTORE'); lCmd.Add(aDst);
    for var K in aKeys do lCmd.Add(K);
    Result := ExecuteAndParse(lCmd.ToArray).AsInteger;
  finally
    lCmd.Free;
  end;
end;

